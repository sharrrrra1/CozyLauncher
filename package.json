{
  "name": "cozy-launcher",
  "version": "1.1.0",
  "private": true,
  "description": "Cozy Launcher — уютный лаунчер Minecraft с офлайн и Microsoft аккаунтами",
  "author": "CozyPOLIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "sprites": "node scripts/extract-mc-textures.mjs && node scripts/make-mc-sprites.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "sums": "node scripts/sha256sums.mjs",
    "dist": "npm run build && electron-builder --win nsis portable && npm run sums",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "com.cozypolit.cozylauncher",
    "productName": "Cozy Launcher",
    "copyright": "CozyPOLIT",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "publish": {
      "provider": "github",
      "owner": "sharrrrra1",
      "repo": "CozyLauncher"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cozy Launcher",
      "artifactName": "CozyLauncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CozyLauncher-Portable-${version}.${ext}"
    }
  }
}
